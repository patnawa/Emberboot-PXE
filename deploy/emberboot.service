[Unit]
Description=Emberboot PXE boot server
Documentation=https://github.com/tsm-thailand/emberboot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/emberbootd -config /etc/emberboot/emberboot.yaml
WorkingDirectory=/var/lib/emberboot
# Crash-only design: always restart, fast. The crash marker fires the
# crash-restart webhook alert on the next start.
Restart=always
RestartSec=1
# UDP 67/69 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
DynamicUser=true
StateDirectory=emberboot
ConfigurationDirectory=emberboot
ReadWritePaths=/var/lib/emberboot
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
